# Application Settings
PROJECT_NAME="Sổ Điểm Danh API"
API_V1_STR="/api"
SECRET_KEY="super_secret_jwt_key_change_in_production_please_generate_random_key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL)
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/attendance_db"

# Chỉ đặt true khi dev local không có PostgreSQL. TUYỆT ĐỐI để false trên production (Render).
USE_SQLITE_FALLBACK=false
